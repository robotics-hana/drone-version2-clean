#$ -l h_rt=24:00:00
#$ -l gpu=1
#$ -ac allow=L
#$ -N airvla_v2res
#$ -wd /home/ucabhe0/Scratch/airvla
#$ -o /home/ucabhe0/Scratch/airvla/logs/v2train_resume.log
#$ -j y
export HF_HOME=$HOME/Scratch/hf_cache
export HF_LEROBOT_HOME=/home/ucabhe0/Scratch/hf_cache/lerobot
export HF_HUB_OFFLINE=1
# JANITOR: v2 optimizer states are ~14 GB each and blew the quota at
# step 5000 -- keep only the newest two, prune the rest every 15 min
(
  while true; do
    sleep 900
    cd /home/ucabhe0/Scratch/airvla/pi0_v2_out/checkpoints 2>/dev/null || continue
    for d in $(ls -d [0-9]* 2>/dev/null | sort -n | head -n -2); do
      rm -rf $d/training_state
    done
  done
) &
JANITOR=$!
/home/ucabhe0/Scratch/env-pin/bin/lerobot-train --config_path=/home/ucabhe0/Scratch/airvla/pi0_v2_out/checkpoints/last/pretrained_model/train_config.json --resume=true
RC=$?
kill $JANITOR 2>/dev/null
echo V2RESUME-EXIT=$RC
