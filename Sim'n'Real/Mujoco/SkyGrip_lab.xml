<mujoco model="SkyGrip_lab">
  <!-- The validated SkyGrip model, flown inside the scanned lab.

       SkyGrip_core.xml carries the whole airframe (gripper, arm, actuators, cameras),
       shared verbatim with the validated SkyGrip_full.xml -- this scene swaps the
       grey pedestal task for the scanned lab + mustard bottle + bin. Keeping
       them separate also means the bare-scene model is still there for fast runs --
       the lab adds 163k triangles and 82 MB of texture, which is real render cost
       you do not want in every physics-only test.

       lab.xml is generated by prepare_lab_scene.py; do not hand-edit it. -->
  <include file="SkyGrip_core.xml"/>
  <include file="lab.xml"/>
  <include file="objects_lab.xml"/>
  <include file="mocap_markers.xml"/>

  <!-- Hole mask. The scan has real gaps in the floor, and through them you see the
       bare-scene checkerboard ground plane from SkyGrip_full.xml -- black-and-grey
       squares punched through the middle of the lab, which would be a glaring
       sim-only artefact in every training image. This thin slab sits 2 mm above the
       plane in the mean colour of the scan's own NON-BLUE floor, so a gap reads as lab
       floor. It is deliberately not the mat's blue: the mat is a specific 4.3 x 5.8 m
       rectangle (see lab.xml) and painting the whole room blue would misrepresent it. Visual only (contype/conaffinity 0) -- the ground plane is
       still what the drone actually lands on, so the physics is untouched. It does
       NOT fix the gaps in the walls and clutter, which need a better scan. -->
  <worldbody>
    <geom name="scan_hole_mask" type="box" pos="0 0 0.002" size="4.6 5.0 0.001"
          rgba="0.702 0.635 0.545 1" contype="0" conaffinity="0" group="2"/>
  </worldbody>
</mujoco>
