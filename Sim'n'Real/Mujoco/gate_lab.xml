<mujocoinclude>
  <!-- Race-style gate for the AirVLA-recreation navigation task
       ("fly through the gate and hover over the {object}").

       Opening 0.90 m wide x 1.06 m tall (inner span x +-0.45, z 0.34..1.40):
       the airframe spans 0.387 x 0.347 m rotor-tip and, at the camera-down
       travel pose, hangs the arm ~0.28 m below the body with legs at
       -0.15 m -- at a 0.85 m crossing altitude the vehicle occupies roughly
       z 0.55..0.92, leaving >0.2 m to every gate member.

       The paper trains/tests the gate at LEFT and RIGHT positions; the
       collector repositions this single static body per episode by writing
       model.body_pos (same mechanism as the pedestal), nominal positions
       (-0.7, -0.6) and (+0.7, -0.6) between the start zone and the mat.

       Bright orange, visually unmistakable against the scanned lab. Static
       and collidable: clipping a member is a real crash, as in the paper. -->
  <worldbody>
    <!-- Lab external camera (user-adopted 2026-08-23): ceiling corner
         nearest the wooden box, measured from the scanned room mesh
         (30 cm inside the +x,+y wall corner), aimed at the work-area
         centre. This is the ORIGINAL box-corner framing (fovy 62, box
         in the near foreground); a whole-mat fovy-74 variant was
         demoed and declined -- see corner2_demo.py for both. -->
    <camera name="lab_external" pos="4.10 3.87 3.20"
            xyaxes="-0.685 0.728 0  -0.342 -0.322 0.883" fovy="62"/>
    <body name="gate" pos="-0.7 -0.6 0">
      <geom name="gate_post_l" type="box" pos="-0.48 0 0.70" size="0.03 0.03 0.70"
            rgba="0.95 0.45 0.10 1"/>
      <geom name="gate_post_r" type="box" pos="0.48 0 0.70" size="0.03 0.03 0.70"
            rgba="0.95 0.45 0.10 1"/>
      <geom name="gate_top" type="box" pos="0 0 1.43" size="0.51 0.03 0.03"
            rgba="0.95 0.45 0.10 1"/>
      <geom name="gate_bottom" type="box" pos="0 0 0.31" size="0.51 0.03 0.03"
            rgba="0.95 0.45 0.10 1"/>
    </body>
  </worldbody>
</mujocoinclude>
