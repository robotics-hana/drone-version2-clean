<mujoco model="SkyGrip_full">
    <compiler angle="radian" meshdir="./"/>
    <option timestep="0.001" gravity="0 0 -9.81" integrator="RK4"/>
        <visual>
            <map znear="0.001"/>
        </visual>
    <asset>
        <mesh name="base_link" content_type="model/stl" file="base_link.STL"/>
        <mesh name="Link_1" content_type="model/stl" file="Link_1.STL"/>
        <mesh name="connect" content_type="model/stl" file="connect.STL" scale="0.001 0.001 0.001"/>
        <mesh name="link5_1" content_type="model/stl" file="link5_1.stl" scale="0.001 0.001 0.001"/>
        <mesh name="clamp_1" content_type="model/stl" file="clamp_1.stl" scale="0.001 0.001 0.001"/>
        <mesh name="clamp_2" content_type="model/stl" file="clamp_2.stl" scale="0.001 0.001 0.001"/>

        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
        <texture name="grid" type="2d" builtin="checker" rgb1="0.1 0.1 0.1" rgb2="0.15 0.15 0.15" width="512" height="512" mark="cross" markrgb="0.2 0.2 0.2"/>
        <material name="grid_mat" texture="grid" texrepeat="1 1" texuniform="true"/>
    </asset>

    <contact>
        <exclude body1="base_link" body2="Link_1"/>
        <exclude body1="Link_1" body2="connect"/>
        <exclude body1="connect" body2="gripper_assembly"/>
        <exclude body1="gripper_assembly" body2="clamp_1"/>
        <exclude body1="gripper_assembly" body2="clamp_2"/>
        <exclude body1="clamp_1" body2="clamp_2"/>
        <exclude body1="Link_1" body2="clamp_1"/>
        <exclude body1="Link_1" body2="clamp_2"/>
        <exclude body1="connect" body2="clamp_1"/>
        <exclude body1="connect" body2="clamp_2"/>
        
        <exclude body1="base_link" body2="connect"/>
        <exclude body1="base_link" body2="gripper_assembly"/>
    </contact>

    <equality>
        <joint joint1="right_clamp" joint2="left_clamp" polycoef="0 -1 0 0 0"/>
    </equality>

    <actuator>
        <motor joint="Joint_1" name="act1" gear="1" ctrlrange="-6 6"/>
        <motor joint="Joint_2" name="act2" gear="1" ctrlrange="-4 4"/>
    </actuator>

    <worldbody>
        <geom name="ground" type="plane" size="20 20 0.1" material="grid_mat"/>

        <light name="sunlight" directional="true" pos="0 0 4" dir="0 0 -1" castshadow="true" diffuse="0.8 0.8 0.8"/>
        <light name="ambient_fill" directional="false" pos="0 0 5" castshadow="false" diffuse="0.3 0.3 0.3" ambient="0.2 0.2 0.2"/>

        <body name="base_link" pos="0 0 1.5">
            <freejoint name="drone_free_joint"/>

            <inertial mass="1.0"
                      pos="1.928E-06 0.0086666 0.027403"
                      diaginertia="0.00409 0.0055803 0.0094981"/>

            <!-- Forward/navigation view. Orientation unchanged (faces +y, pitched ~44 deg down),
                 matching the real airframe where the Pi sits at the back facing forward.
                 Moved forward along +y only: at the old y=0.010 the base_link mesh (which spans
                 y -0.138..+0.169) sat directly in the line of sight, so the gripper was occluded
                 by the drone's own body at every arm pose -- renders showed only propellers.
                 y=0.150 is just inside the nose, clearing the body while staying mountable.
                 Gripper is well framed when the arm is up-and-forward (Joint_1 ~1.0-1.6),
                 marginal at mid poses where it hangs near the lower frame edge.
                 Previous value: pos="0 0.01 0.15" -->
            <camera name="scene_cam" pos="0 0.15 0.02" xyaxes="1.95 0.05 0 -0.02 0.98 1" fovy="100"/>

            <geom type="mesh" mesh="base_link" rgba="0.7 0.7 0.9 1"/>
            <geom name="leg_front_left" type="cylinder" size="0.008 0.12" pos="0.108 0.088 -0.08" rgba="0.2 0.2 0.2 1" density="0" mass="0.00"/>
            <geom name="leg_front_right" type="cylinder" size="0.008 0.12" pos="0.108 -0.088 -0.08" rgba="0.2 0.2 0.2 1" density="0" mass="0.00"/>
            <geom name="leg_back_left" type="cylinder" size="0.008 0.12" pos="-0.108 0.088 -0.08" rgba="0.2 0.2 0.2 1" density="0" mass="0.00"/>
            <geom name="leg_back_right" type="cylinder" size="0.008 0.12" pos="-0.108 -0.088 -0.08" rgba="0.2 0.2 0.2 1" density="0" mass="0.00"/>

            <site name="thrust_point" pos="0 0 0" size="0.02" rgba="0 1 1 0.8" type="sphere"/>

            <body name="Link_1" pos="0.001 -2.5e-05 -0.038" quat="1 -0.000327565 0 0">
                <inertial pos="-0.0016184 -7.0854E-06 -0.08892" 
                            mass="0.08" 
                            diaginertia="1.7491E-05 2.2905E-05 1.2e-5"/>
                <joint name="Joint_1" pos="0 0 0" axis="1 0 0" range="-1.6 1.6" damping="0.372" frictionloss="0.08"/>
                <geom contype="0" conaffinity="0" type="mesh" mesh="Link_1" rgba="1 0.95 0.9 1"/>

                <body name="connect" pos="-0.003 0 -0.1308" quat="0.7071068 0.7071068 0 0">
                    <inertial pos="-0.001844 0 -0.069214" quat="0.500405 0.500421 0.499579 -0.499595" mass="0.008" diaginertia="1.551697e-05 1.472678e-05 1.656619e-06"/>
                    <joint name="Joint_2" pos="0 0 0" axis="1 0 0" range="-1.6 1.6"  damping="0.235" frictionloss="0.203"/>
                    <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.6 0.6 0.6 1" mesh="connect"/>
                    <geom type="mesh" rgba="0.6 0.6 0.6 1" mesh="connect"/>

                    <body name="gripper_assembly" pos="0 0 .03" quat="-0.7071068 0.7071068 0 0">
                        <inertial pos="-0.00058149 -0.04152732 0.01506014" mass="0.10"
                                  fullinertia="1.39530e-05 2.37113e-05 1.77618e-05 2.1541e-08 -1.08927e-07 -2.01421e-06"/>
                        <geom type="mesh" pos="-0.007062 0.120627 -0.152066" contype="0" conaffinity="0" group="1" density="0" mesh="link5_1"/>
                        <geom type="mesh" pos="-0.007062 0.120627 -0.152066" mesh="link5_1"/>

                        <!-- Manipulation close-up. Top-down over the jaws at 10.5 cm.
                             A ray-cast sweep of 1915 mount points around the gripper found NONE
                             with line-of-sight along the approach axis (-y): the link5_1 mesh
                             envelops everything behind the jaws, so a forward-looking wrist view
                             is geometrically impossible on this mesh. Every unoccluded view is
                             perpendicular to the approach. Verified via camera_check.py:
                             object visible at zero / reach / extended.
                             Previous value (renders as a flat grey plate at every pose -- the
                             camera sat inside the link5_1 mesh, blocked at 9 mm):
                               pos="0 -0.028 0.082" xyaxes="-1 0 0 0 -0.574 0.819" fovy="110" -->
                        <camera name="wrist_cam" pos="0 -0.075 0.105" xyaxes="1 0 0.004  0 1 0.025" fovy="85"/>

                        <!-- True end-effector: midpoint between the jaws, where a grasped object
                             actually sits. This is 7.2 cm from the gripper_assembly body origin
                             (the clamp meshes carry large offsets), so using the body origin as
                             an EE proxy puts the reaching cost 7.2 cm off -- wider than a 4 cm
                             target cube, i.e. the optimiser converges "on target" with the object
                             outside the jaws. Position is invariant to both gripper aperture
                             (the clamps slide symmetrically) and arm pose, so a static site is
                             exact rather than an approximation. -->
                        <site name="grasp_site" pos="0.00043 -0.07236 -0.00018" size="0.006"
                              rgba="1 0.5 0 0.9" type="sphere"/>
                        
                        <body name="clamp_1" pos="-0.052134 -0.220077 -0.186037">
                            <inertial pos="0.0601695 0.144807 0.184483" quat="0.745779 0.661192 0.0475856 -0.0661414"
                                      mass="0.002" diaginertia="4.39584e-05 3.72410e-05 2.06103e-05"/>
                            <joint name="right_clamp" pos="0 0 0" axis="0.999848 -0.000154 0.017451" type="slide"
                                   range="0 0.037" actuatorfrcrange="-1.9 1.9" damping="0.5" frictionloss="0.1"/>
                            <geom pos="0.045072 0.340704 0.033971" type="mesh" mesh="clamp_1"/>
                        </body>

                        <body name="clamp_2" pos="0.072828 -0.222278 -0.183875">
                            <inertial pos="-0.0800042 0.14701 0.185068" quat="0.661192 0.745779 0.0661414 -0.0475856"
                                      mass="0.002" diaginertia="4.39584e-05 3.72410e-05 2.06103e-05"/>
                            <joint name="left_clamp" pos="0 0 0" axis="0.999848 -0.000154 0.017451" type="slide"
                                   range="-0.038 0" actuatorfrcrange="-1.9 1.9" damping="0.5" frictionloss="0.1"/>
                            <geom pos="-0.07989 0.342905 0.031809" type="mesh" mesh="clamp_2"/>
                        </body>
                    </body>
                </body>
            </body>
        </body>

        <body name="current_target" pos="0 0 1.5" mocap="true">
            <geom type="sphere" size="0.05" rgba="0 1 0 0.8" contype="0" conaffinity="0"/>
        </body>
        <body name="waypoint_0" pos="0 0 1.5" mocap="true">
            <geom type="sphere" size="0.02" rgba="0.5 0.5 1 0.5" contype="0" conaffinity="0"/>
        </body>
        <body name="waypoint_1" pos="0 0 1.5" mocap="true">
            <geom type="sphere" size="0.02" rgba="0.5 0.5 1 0.5" contype="0" conaffinity="0"/>
        </body>
    </worldbody>
</mujoco>