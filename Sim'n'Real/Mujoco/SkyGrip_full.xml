<mujoco model="SkyGrip_full">
    <compiler angle="radian" meshdir="./"/>
    <option timestep="0.001" gravity="0 0 -9.81" integrator="RK4"/>
        <visual>
            <map znear="0.001"/>
        </visual>
    <asset>
        <mesh name="base_link" content_type="model/stl" file="base_link.STL"/>
        <mesh name="Link_1" content_type="model/stl" file="Link_1.STL"/>
        <!-- Filename case must match the file on disk EXACTLY. The file is
             connect.stl (lowercase); this said connect.STL, which loads fine on
             Windows because NTFS is case-insensitive but fails on Linux -- i.e.
             it would have broken on the Spark GPU server, not here. -->
        <mesh name="connect" content_type="model/stl" file="connect.stl" scale="0.001 0.001 0.001"/>
        <mesh name="link5_1" content_type="model/stl" file="link5_1.stl" scale="0.0001 0.0001 0.0001"/>
        <mesh name="clamp_1" content_type="model/stl" file="clamp_1.stl" scale="0.001 0.001 0.001"/>
        <mesh name="clamp_2" content_type="model/stl" file="clamp_2.stl" scale="0.001 0.001 0.001"/>

        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
        <texture name="grid" type="2d" builtin="checker" rgb1="0.1 0.1 0.1" rgb2="0.15 0.15 0.15" width="512" height="512" mark="cross" markrgb="0.2 0.2 0.2"/>
        <material name="grid_mat" texture="grid" texrepeat="1 1" texuniform="true"/>
    </asset>

    <contact>
        <exclude body1="base_link" body2="Link_1"/>
        <exclude body1="Link_1" body2="connect"/>
        <exclude body1="connect" body2="gripper_assembly"/>
        <exclude body1="gripper_assembly" body2="clamp_1"/>
        <exclude body1="gripper_assembly" body2="clamp_2"/>
        <exclude body1="clamp_1" body2="clamp_2"/>
        <exclude body1="Link_1" body2="clamp_1"/>
        <exclude body1="Link_1" body2="clamp_2"/>
        <exclude body1="connect" body2="clamp_1"/>
        <exclude body1="connect" body2="clamp_2"/>
        
        <exclude body1="base_link" body2="connect"/>
        <exclude body1="base_link" body2="gripper_assembly"/>
    </contact>

    <equality>
        <joint joint1="right_clamp" joint2="left_clamp" polycoef="0 -1 0 0 0"/>
    </equality>

    <!-- Seven actuators. ORDER IS LOAD-BEARING: skygrip.py assigns MPPI noise by index
         (0,1,2 = arm/gripper, 3 = thrust, 4,5,6 = torques), while Skygrip_objective.py
         looks them up by name. Renaming or reordering breaks one or the other.

         Thrust and body torques are site-mounted motors rather than xfrc_applied (which
         is what create_force_general.py used). Physically equivalent -- gear "0 0 1 0 0 0"
         on thrust_point applies force along the body z axis at the body origin, exactly as
         the old R @ [0,0,thrust] did -- but expressed as ctrl, so MJX can see it. The JAX
         path rolls out through mjx and cannot read xfrc_applied, so this is required for
         Skygrip_objective_jax.py to work at all.

         Arm and gripper are POSITION actuators, not torque. This is the action-space
         decision: joint-position targets are what the VLA emits (matching the dissertation's
         joint-space choice), they stay meaningful across action-chunk boundaries, and they
         let MPPI explore in radians rather than newton-metres.

         ARM forcerange is bounded by the BODY's attitude authority, not by what the servo
         could theoretically deliver. This was +-6 / +-4 N*m, inherited from the old torque
         motors, and it is why commanding Joint_1 flung the whole aircraft: the arm could
         apply 6 N*m while roll_torque can only resist 1 N*m, so the reaction was
         literally uncontrollable (1467 rad/s^2 on Ixx=0.0041). Joint_1 rotates about x and
         so does roll, so it loads the weakest axis. Measured on a 0->0.9 rad step while
         hovering: +-6/+-4 threw the body 17.4 deg and 83 mm; +-0.6/+-0.4 gives 5.4 deg and
         46 mm and still holds station.
         The arm only NEEDS 0.21 N*m to hold itself plus a 10 g payload at worst extension
         (arm subtree is 0.192 kg), so +-0.6 keeps ~3x static margin while staying well
         under the 1 N*m the flight controller can trim against.
         kp stays stiff on purpose: with the setpoint rate-limited (ARM_SLEW_RATE) the
         tracking error is tiny and never saturates, so precision is unaffected -- the
         forcerange only bites on aggressive/step commands, which is exactly where it
         should. -->

    <actuator>
        <position name="act_joint1" joint="Joint_1" ctrlrange="-1.6 1.6" forcerange="-0.6 0.6" kp="998.22" kv="2.731"/>
        <position name="act_joint2" joint="Joint_2" ctrlrange="-1.6 1.6" forcerange="-0.4 0.4" kp="998.22" kv="2.731"/>
        <position name="act_gripper" joint="right_clamp" ctrlrange="0 0.037" forcerange="-3.5 3.5" kp="998.22" kv="2.731"/>
        <!-- act_gripper_left removed — left_clamp is mechanically slaved to right_clamp
            via the equality constraint below, matching the real linkage. -->
        <motor name="thrust" site="thrust_point" gear="0 0 1 0 0 0" ctrlrange="0 30"/>
        <motor name="roll_torque" site="thrust_point" gear="0 0 0 1 0 0" ctrlrange="-1 1"/>
        <motor name="pitch_torque" site="thrust_point" gear="0 0 0 0 1 0" ctrlrange="-1 1"/>
        <motor name="yaw_torque" site="thrust_point" gear="0 0 0 0 0 1" ctrlrange="-1 1"/>
    </actuator>

    <worldbody>
        <geom name="ground" type="plane" size="20 20 0.1" material="grid_mat"/>

        <light name="sunlight" directional="true" pos="0 0 4" dir="0 0 -1" castshadow="true" diffuse="0.8 0.8 0.8"/>
        <light name="ambient_fill" directional="false" pos="0 0 5" castshadow="false" diffuse="0.3 0.3 0.3" ambient="0.2 0.2 0.2"/>

        <body name="base_link" pos="0 0 1.5">
            <freejoint name="drone_free_joint"/>

            <!-- Body + battery, WITHOUT the arm. The aircraft weighs 1179 g all-up and
                 the arm is 250-300 g measured directly, so base_link = 1179 - 275 = 904 g.
                 Do NOT re-derive the arm from 817 - 386: those two weighings do not
                 bracket the arm cleanly and give 431 g, which is wrong and unflyable
                 (0/12 picks, 11 crashes). The direct arm measurement is the one to trust.
                 An even earlier pass had 1107/72 -- right total, distribution backwards.
                 diaginertia scaled from the 1.0 kg reference by 0.904; that assumes the
                 battery is distributed like the rest of the body, an approximation worth
                 refining if the pack's position is known. -->
            <inertial mass="0.904"
                      pos="1.928E-06 0.0086666 0.027403"
                      diaginertia="0.0036974 0.0050446 0.0085863"/>

            <!-- Forward/navigation view. Orientation unchanged (faces +y, pitched ~44 deg down),
                 matching the real airframe where the Pi sits at the back facing forward.
                 Moved forward along +y only: at the old y=0.010 the base_link mesh (which spans
                 y -0.138..+0.169) sat directly in the line of sight, so the gripper was occluded
                 by the drone's own body at every arm pose -- renders showed only propellers.
                 y=0.150 is just inside the nose, clearing the body while staying mountable.
                 Gripper is well framed when the arm is up-and-forward (Joint_1 ~1.0-1.6),
                 marginal at mid poses where it hangs near the lower frame edge.
                 Previous value: pos="0 0.01 0.15" -->
            <!-- Aimed DOWN and BACK, not forward. The task is an overhead grasp: at
                 GRASP the block sits 54 mm behind and 200 mm below the body (the
                 body->jaw offset), so the previous forward-and-45-deg-down aim
                 pointed straight past the workspace. Verified against the recorded
                 dataset: camera2 showed only floor and horizon in every frame
                 sampled, mid-grasp included, so that stream carried no task
                 information at all.
                 Mounted at the nose tip and below the body plane because anything
                 inside the airframe just films the drone's own underside.
                 50 deg from vertical; xyaxes y-column is (0, cos50, -sin50).
                 Previous value: pos="0 0.15 0.02" xyaxes="1.95 0.05 0 -0.02 0.98 1" -->
            <camera name="scene_cam" pos="0 -0.07 0.15" xyaxes="-1.95 0.05 0  0.02 -0.98 1" fovy="100"/>

            <!-- Third-person chase view, behind and above the airframe. Not part of the
                 training observation (CAMERAS maps only camera1/camera2); kept as a
                 review/rendering viewpoint. Restored after being deleted by accident in
                 V0.16.0 -- an XML span was replaced by index and took this with it. -->
            <camera name="overview_cam" pos="-0.002 0.4234 0.2879" xyaxes="-1 0 0  0 -0.7679 0.6406" fovy="65"/>

            <!-- Chase view: behind and above the airframe, looking forward and down over
                 the drone at the workspace. Mounted on base_link, NOT on the gripper --
                 a gripper-mounted version swings with the arm and the framing breaks.
                 Shows the drone, the arm hanging below, and the objects ahead in one
                 frame. Replaces the earlier jaw-close-up, which framed the grasp well but
                 left the gripper hanging in empty space with the objects as specks at the
                 bottom edge during the whole approach. Pose derived in _chasecam.py /
                 _tobase.py and chosen from rendered candidates. -->

            <geom type="mesh" mesh="base_link" rgba="0.7 0.7 0.9 1"/>
            <!-- Legs shortened: they reached 0.200 m below the body, which set the whole
                 platform's minimum working height and left the gripper barely clearing
                 the table. Now 0.150 m, still just below the folded-arm gripper so the
                 airframe rests on its legs rather than its jaws. -->
            <geom name="leg_front_left" type="cylinder" size="0.008 0.085" pos="0.108 0.088 -0.065" rgba="0.2 0.2 0.2 1" density="0" mass="0.00"/>
            <geom name="leg_front_right" type="cylinder" size="0.008 0.085" pos="0.108 -0.088 -0.065" rgba="0.2 0.2 0.2 1" density="0" mass="0.00"/>
            <geom name="leg_back_left" type="cylinder" size="0.008 0.085" pos="-0.108 0.088 -0.065" rgba="0.2 0.2 0.2 1" density="0" mass="0.00"/>
            <geom name="leg_back_right" type="cylinder" size="0.008 0.085" pos="-0.108 -0.088 -0.065" rgba="0.2 0.2 0.2 1" density="0" mass="0.00"/>

            <site name="thrust_point" pos="0 0 0" size="0.02" rgba="0 1 1 0.8" type="sphere"/>

            <body name="Link_1" pos="0.001 -2.5e-05 -0.038" quat="1 -0.000327565 0 0">
                <!-- PROVISIONAL SPLIT of the weighed 431 g arm. The 8 g here previously was
                     the PRINTED LINK ONLY; the weighed arm is 431 g, the balance being
                     servos, brackets and wiring. Assumed here: printed link + the Joint_1
                     (shoulder) servo = 150 g. Confirm against the real build -- where the
                     servo mass sits sets the arm's centre of mass, which drives the roll
                     coupling, so this split matters more than the per-link totals.
                     diaginertia scaled from the 80 g reference by 1.875. -->
                <inertial pos="-0.0016184 -7.0854E-06 -0.08892"
                            mass="0.095"
                            diaginertia="2.0770E-05 2.7200E-05 1.425e-05"/>
                <joint name="Joint_1" pos="0 0 0" axis="1 0 0" range="-1.6 1.6" damping="0.372" frictionloss="0.08"/>
                <geom contype="0" conaffinity="0" type="mesh" mesh="Link_1" rgba="1 0.95 0.9 1"/>

                <body name="connect" pos="-0.003 0 -0.1308" quat="0.7071068 0.7071068 0 0">
                    <!-- Provisional: printed link + Joint_2 (elbow) servo = 120 g of the
                         weighed 431 g arm. diaginertia scaled from the 8 g reference by 15. -->
                    <inertial pos="-0.001844 0 -0.069214" quat="0.500405 0.500421 0.499579 -0.499595" mass="0.075" diaginertia="1.454716e-04 1.380636e-04 1.553080e-05"/>
                    <joint name="Joint_2" pos="0 0 0" axis="1 0 0" range="-1.6 1.6"  damping="0.235" frictionloss="0.203"/>
                    <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.6 0.6 0.6 1" mesh="connect"/>
                    <geom type="mesh" rgba="0.6 0.6 0.6 1" mesh="connect"/>

                    <body name="gripper_assembly" pos="0 0 .03" quat="-0.7071068 0.7071068 0 0">
                        <!-- Provisional: housing + gripper servo = 141 g of the weighed 431 g
                             arm (36 g of that is the printed housing). This is the mass
                             furthest from the shoulder, so it dominates the arm's CoM and the
                             gravity moment the flight controller has to trim.
                             fullinertia scaled from the 100 g reference by 1.41. -->
                        <inertial pos="-0.00058149 -0.04152732 0.01506014" mass="0.085"
                                  fullinertia="1.18601e-05 2.01546e-05 1.50975e-05 1.83099e-08 -9.25880e-08 -1.71208e-06"/>
                        <geom type="mesh" pos="-0.007062 0.120627 -0.152066" contype="0" conaffinity="0" group="1" density="0" mesh="link5_1" rgba="0.6 0.6 0.6 1"/>
                        <!-- Housing collision DISABLED, and this is load-bearing for the
                             whole task. MuJoCo collides meshes as their CONVEX HULL, so this
                             C-shaped housing - which in reality has an open mouth between the
                             jaws - becomes a solid block spanning the entire jaw opening.
                             Measured by descending onto a post: first contact was
                             gripper_assembly:geom10 at 62 mm ABOVE the object's top face, while
                             the jaws need to reach 10 mm BELOW it. The gripper could therefore
                             never close on anything standing on a surface; every descent shoved
                             the block off the pedestal and the reaction flipped the drone.
                             Grasping is done by the pad_1/pad_2 boxes, so nothing needs this
                             hull to be collidable. The drone body and legs still collide.
                             If housing collision is ever wanted back, it must be built from
                             primitives that leave the mouth open, NOT from this mesh. -->
                        <geom type="mesh" pos="-0.007062 0.120627 -0.152066" mesh="link5_1"
                              contype="0" conaffinity="0" group="1" rgba="0.6 0.6 0.6 0"/>

                        <camera name="wrist_cam" pos="0 -0.04 0.082" xyaxes="-1 0 0 0 -0.574 0.819" fovy="110"/>

                        <!-- Manipulation close-up. Top-down over the jaws at 10.5 cm.
                             A ray-cast sweep of 1915 mount points around the gripper found NONE
                             with line-of-sight along the approach axis (-y): the link5_1 mesh
                             envelops everything behind the jaws, so a forward-looking wrist view
                             is geometrically impossible on this mesh. Every unoccluded view is
                             perpendicular to the approach. Verified via camera_check.py:
                             object visible at zero / reach / extended.
                             Previous value (renders as a flat grey plate at every pose -- the
                             camera sat inside the link5_1 mesh, blocked at 9 mm):
                               pos="0 -0.028 0.082" xyaxes="-1 0 0 0 -0.574 0.819" fovy="110" -->

                        <!-- True end-effector: the point midway between the jaws' INNER FACES,
                             where a grasped object actually sits.

                             Two corrections are baked into this position:
                               - 72 mm from the gripper_assembly body origin. The clamp meshes
                                 carry large offsets, so the body origin is not near the jaws at
                                 all; using it as the EE reference put the w_ee cost 72 mm off.
                               - a further 21 mm laterally from the midpoint of the two clamp
                                 GEOM ORIGINS. The clamp meshes are asymmetric, so origin-midpoint
                                 is not face-midpoint. Measured from mesh vertices in the gripping
                                 band, the true jaw centre is x = -0.0228 (world, zero pose) while
                                 the origin midpoint reads -0.0016.

                             The lesson both times: measure from the geometry that touches the
                             object, never from body or geom origins.

                             Invariant to gripper aperture (the clamps slide symmetrically) and to
                             arm pose, so a static site is exact rather than an approximation. -->
                        <site name="grasp_site" pos="0.00053 -0.07236 -0.00018" size="0.006"
                              rgba="1 0.5 0 0" type="sphere"/>
                        
                        <body name="clamp_1" pos="-0.052134 -0.220077 -0.186037">
                            <!-- 0.010 kg per jaw, per the measured airframe (was 0.002);
                                 diaginertia scaled by the same 5. -->
                            <inertial pos="0.0601695 0.144807 0.184483" quat="0.745779 0.661192 0.0475856 -0.0661414"
                                      mass="0.010" diaginertia="2.19792e-04 1.86205e-04 1.03052e-04"/>
                            <joint name="right_clamp" pos="0 0 0" axis="0.999848 -0.000154 0.017451" type="slide"
                                   range="0 0.037" actuatorfrcrange="-1.9 1.9" damping="0.5" frictionloss="0.1"/>
                            <!-- Blade lifted so its TIP sits at the pad line rather than
                                 hanging 38 mm (clamp_1) / 65 mm (clamp_2) below the grip
                                 point. The grip point is only ~22 mm above the table, so the
                                 blades used to pass visibly through it. They are decorative
                                 (contype/conaffinity 0 -- the pads do the gripping), so this
                                 is a pure appearance fix; giving them collision instead would
                                 block the descent, since the blade would strike the table
                                 before the pads reached the object. Offsets are along world-up
                                 mapped into the clamp frame at the overhead grasp pose.
                                 Scaling the mesh does NOT help: its origin sits below the
                                 blade, so shrinking pulls the tip further down. -->
                            <geom pos="0.045072 0.347106 0.057468" type="mesh" mesh="clamp_1"
                                  contype="0" conaffinity="0" group="1" rgba="0.5 0.5 0.5 1"/>
                            <!-- Collision pad, flush with the VISIBLE blade face.
                                 Placement is ray-measured (mj_ray straight through the
                                 grasp centre), not derived from mesh vertex bands -- the
                                 previous pads were computed from a measurement that had
                                 the two clamps' sides swapped, so each pad sat on the
                                 opposite side from its own parent blade. They scissored
                                 the wrong way and held the block 14 mm INSIDE the
                                 geometry on screen. -->
                            <!-- Flat jaw plate. quat compensates the clamp body's 21.4deg
                                 tilt about world-x (measured at the overhead grasp pose) so the
                                 gripping FACE is vertical and parallel to the upright block, not
                                 the tilted V it used to render as. Thin along the closing axis
                                 (world x), broad in depth (y) and height (z). This IS the visible
                                 jaw now that the hollow clamp fang is hidden. -->
                            <geom name="pad_1" type="box" pos="0.064589 0.147719 0.185682"
                                  size="0.004 0.010 0.013" quat="0.9827 -0.1853 0 0"
                                  rgba="0.25 0.25 0.3 1"
                                  friction="1.5 0.01 0.001" solref="0.004 1"/>
                        </body>

                        <body name="clamp_2" pos="0.072828 -0.222278 -0.183875">
                            <inertial pos="-0.0800042 0.14701 0.185068" quat="0.661192 0.745779 0.0661414 -0.0475856"
                                      mass="0.010" diaginertia="2.19792e-04 1.86205e-04 1.03052e-04"/>
                            <joint name="left_clamp" pos="0 0 0" axis="0.999848 -0.000154 0.017451" type="slide"
                                   range="-0.038 0" actuatorfrcrange="-1.9 1.9" damping="0.5" frictionloss="0.1"/>
                            <geom pos="-0.079890 0.356382 0.081272" type="mesh" mesh="clamp_2"
                                  contype="0" conaffinity="0" group="1" rgba="0.5 0.5 0.5 1"/>
                            <geom name="pad_2" type="box" pos="-0.084082 0.149916 0.183870"
                                  size="0.004 0.010 0.013" quat="0.9827 -0.1853 0 0"
                                  rgba="0.25 0.25 0.3 1"
                                  friction="1.5 0.01 0.001" solref="0.004 1"/>
                        </body>
                    </body>
                </body>
            </body>
        </body>

        <!-- Pedestal. The arm reaches at most 0.271 m below the body while the legs
             hang 0.200 m down, so picking off the floor would mean hovering at ~0.29 m
             with 9 cm of leg clearance at the j2 joint limit -- no margin against a
             0.10 m controller tolerance. Raising the work surface puts the grasp in
             the middle of the arm's envelope instead of at its edge.
             Long in x, narrow in y (0.40 x 0.10). The drone grasps from directly
             overhead -- straight down is the arm's comfortable direction, reaching
             0.254 m with j2 only at 0.8, whereas forward reach plus depth together
             pushes j2 to its 1.6 limit. Hovering overhead is only safe because the
             legs sit at y = +-0.088 and so straddle a 0.05 half-width surface; a
             wide table would foul them. The x extent gives pick and place two
             distinct spots on the same surface.
             Static -- collect_demos.py repositions it by writing model.body_pos. -->
        <body name="pedestal" pos="0 0.35 0.25">
            <!-- Friction lowered to match the target object. Contact friction is
                 the element-wise max of the pair, so the block can only slide
                 freely on this surface if BOTH are low -- see target_object. -->
            <!-- Enlarged from 0.20 x 0.05 to 0.32 x 0.09 half-extents (0.64 x 0.18 m
                 surface) so three objects fit with real separation and the place point
                 has somewhere to go. collect_demos rewrites geom_size[2] per episode for
                 the working-height randomisation, so only x/y are fixed here. -->
            <geom type="box" size="0.32 0.09 0.25" rgba="0.45 0.42 0.38 1"
                  friction="0.3 0.005 0.0001"/>
        </body>

        <!-- Pick target: a 20 x 20 x 80 mm upright post.
             Both dimensions are dictated by the gripper geometry, measured from
             the meshes rather than from body origins:

               WIDTH. The true inner-face gap between the jaws is 30.7 mm at full
               aperture (0.037) and closes to overlap. Note this is NOT the
               origin-to-origin distance, which reads 87.2 mm -- the same trap as
               using the gripper_assembly body origin for the end effector. 20 mm
               leaves ~5 mm either side on approach.

               HEIGHT. Fingertips reach 49.2 mm BELOW the jaw midpoint while the
               housing obstructs from ~0 mm ABOVE it, so the object must sit
               entirely below the midpoint and be gripped over the 49 mm beneath.
               At 80 mm tall, grasped 5 mm above its top face, the fingertips
               still clear the surface by ~36 mm.

             A 40 mm cube (the original) was unpickable on both counts: too wide
             for the jaws, and shorter than the fingers, so any midpoint clearing
             the surface sat above the cube entirely.
             collect_demos.py randomises this per episode; the pose here is only
             the reset default. On +y, the side the arm reaches toward at positive
             Joint_1 and the side scene_cam faces. -->
        <body name="target_object" pos="0 0.35 0.54">
            <freejoint name="target_free_joint"/>
            <!-- No explicit <inertial>: collect_demos randomises geom_size per
                 episode, and a hardcoded diaginertia would silently describe the
                 wrong shape. Letting MuJoCo derive it from the geom keeps mass
                 properties consistent with whatever size was sampled.

                 mass 10 g (was 50 g). Light on purpose: the jaws inevitably nudge
                 the block as they close, and a light block is both easier to hold
                 (weight 0.098 N against ~5 N of measured grip) and carries less
                 momentum when shifted, so it settles instead of toppling.

                 friction 0.3 (was 1.0), and the PEDESTAL is lowered to match.
                 MuJoCo takes the element-wise MAXIMUM of the two geoms' friction,
                 so lowering only this one would have changed nothing while the
                 pedestal stayed at 1.0. Low friction against the table lets a
                 nudged block SLIDE rather than catch an edge and tip. The pads
                 are 1.5, and max(1.5, 0.3) = 1.5, so the grip itself is
                 unaffected -- slippery on the table, grippy in the jaws. -->
            <geom type="box" size="0.010 0.010 0.040" rgba="0.85 0.2 0.2 1"
                  mass="0.010" friction="0.3 0.005 0.0001"/>
        </body>

        <!-- Distractor: a second block, identical in kind to target_object but a
             DIFFERENT colour, used for language grounding. The episode's task names
             a colour ("pick up the red block"); with two differently-coloured
             blocks present the instruction is now informative -- the policy has to
             key on colour to pick the right one, and success requires leaving this
             one untouched. collect_demos randomises its size/pose/colour per
             episode; the pose here is only the reset default, parked to one side. -->
        <body name="distractor_object" pos="-0.12 0.35 0.54">
            <freejoint name="distractor_free_joint"/>
            <geom type="box" size="0.010 0.010 0.040" rgba="0.2 0.35 0.85 1"
                  mass="0.010" friction="0.3 0.005 0.0001"/>
        </body>

        <!-- Second distractor. Three objects on the surface makes the colour/shape
             grounding a genuine 1-of-3 choice rather than 1-of-2, and success still
             requires leaving BOTH unnamed objects untouched. Same size/mass/friction
             family as the others; collect_demos randomises pose, size, shape and
             colour per episode. -->
        <body name="distractor_object_2" pos="0.12 0.35 0.54">
            <freejoint name="distractor2_free_joint"/>
            <geom type="box" size="0.010 0.010 0.040" rgba="0.85 0.7 0.2 1"
                  mass="0.010" friction="0.3 0.005 0.0001"/>
        </body>

        <body name="current_target" pos="0 0 1.5" mocap="true">
            <!-- Debug marker, alpha 0: nothing moves it any more (the PD controller
                 does not use it), so it just sits at (0,0,1.5). Made invisible so it
                 can never leak into an onboard training frame. -->
