<mujoco model="SkyGrip_full">
    <!-- The validated bare pick-and-place model, now composed from two includes.
         This file compiles to the same model as the old monolith: same joint and
         qpos ordering (the pedestal bodies carry the only scene freejoints, and
         mocap bodies contribute no joints), same masses, same actuators. The split
         exists so SkyGrip_lab.xml can reuse the drone WITHOUT this scene:
         swap pedestal_task.xml for lab.xml + objects_lab.xml and nothing about
         the airframe changes. Do not add drone parameters here -- they live in
         SkyGrip_core.xml. -->
    <include file="SkyGrip_core.xml"/>
    <include file="pedestal_task.xml"/>
    <include file="mocap_markers.xml"/>
</mujoco>
